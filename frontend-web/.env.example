# Só servidor (SSR). Nunca NEXT_PUBLIC_*: o token não pode chegar ao browser.
API_INTERNAL_URL=http://127.0.0.1:8080
# O mesmo valor do INTERNAL_PROXY_TOKEN do backend-rust (>= 32 bytes).
INTERNAL_PROXY_TOKEN=
# Host do painel de backoffice (ex.: admin.ptmarket.pt). Sem valor, /painel responde 404.
PLATFORM_ADMIN_HOST=
# Chave pública (site key) do Cloudflare Turnstile, só para o widget do login de staff.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
