# APP_ENV é obrigatória: development | test | staging | production (exato, minúsculas). Sem ela o worker
# e o verify-audit não arrancam. Em staging e production são recusados ALERT_DEV_LOG_ONLY=1 e um
# WORM_ENDPOINT que não comece por https://.
APP_ENV=development
WORKER_DATABASE_URL=postgres://ptmarket_worker:CHANGE_ME@127.0.0.1:5432/ptmarket
REDIS_URL=redis://127.0.0.1:6379/0
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH=100
# Cartão 02/09 — caixa negra: WORM (S3 compatível; produção = Backblaze B2, Object Lock GOVERNANCE).
# Sem WORM_BUCKET/endpoint/chaves o worker não arranca. A chave só pode ter Put/Get (sem Delete nem bypass).
WORM_ENDPOINT=http://127.0.0.1:9000
WORM_REGION=us-east-1
WORM_BUCKET=
WORM_ACCESS_KEY=
WORM_SECRET_KEY=
# Retenção em dias (decisão do owner: eventos 2 anos, raízes 10 anos).
WORM_EVENTS_RETENTION_DAYS=730
WORM_ROOTS_RETENTION_DAYS=3650
# Alertas críticos (pelo menos um canal: Telegram e/ou Discord).
# Mais de 5 alertas do mesmo tipo em 5 min: os 5 primeiros saem um a um, o resto num resumo no fim da janela.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK_URL=
# ALERT_SINK=log:// envia também para o log do worker. Como ÚNICO canal só arranca com ALERT_DEV_LOG_ONLY=1.
# NUNCA em produção: alertas críticos só no log = ninguém é avisado.
ALERT_SINK=
ALERT_DEV_LOG_ONLY=
