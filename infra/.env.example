# SÓ DESENVOLVIMENTO — valores por omissão do compose; nunca usar em produção.
POSTGRES_PASSWORD=dev_postgres
PTM_MIGRATOR_PASSWORD=dev_migrator
PTM_APP_PASSWORD=dev_app
PTM_WORKER_PASSWORD=dev_worker
# WORM local (S3 com Object Lock; serviço worm em 127.0.0.1:7070). Em produção: externo (R2/S3), outra conta.
