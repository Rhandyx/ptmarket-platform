# Obrigatório: development | test | staging | production (valor exato; sem ele a API não arranca).
# Em staging/production passam a ser OBRIGATÓRIAS (arranque recusado sem elas): TRUSTED_PROXY_CIDRS,
# INTERNAL_PROXY_TOKEN, CSRF_KEY, PLATFORM_ADMIN_HOST, ACCOUNT_HASH_KEY, TOTP_ENC_KEY e TURNSTILE_SECRET (real; as chaves
# de teste 1x/2x/3x da Cloudflare são recusadas).
APP_ENV=development
# A API liga como ptmarket_app (sem SUPERUSER/BYPASSRLS). Valores de exemplo, sem segredos reais.
DATABASE_PRIMARY_URL=postgres://ptmarket_app:CHANGE_ME@127.0.0.1:5432/ptmarket
# Fase 1: o mesmo Postgres
DATABASE_REPLICA_URL=postgres://ptmarket_app:CHANGE_ME@127.0.0.1:5432/ptmarket
REDIS_URL=redis://127.0.0.1:6379
BIND_ADDR=127.0.0.1:8080
# Cartão 02/11 (opcionais). Sem PLATFORM_ADMIN_HOST nenhum host é de plataforma.
PLATFORM_ADMIN_HOST=admin.ptmarket.localhost
# Só com este token (>= 32 bytes, gerar com: openssl rand -hex 32) o SSR do Next pode mandar X-Forwarded-Host.
INTERNAL_PROXY_TOKEN=
# Cartão 02/16 (obrigatória): chave HMAC dos tokens CSRF; ≥ 32 bytes; gerar com openssl rand -hex 32
CSRF_KEY=
# Cartão 02/17 — chave secreta do Cloudflare Turnstile (registo de clientes). Sem ela, /auth/register → 503.
# Dev: a chave de teste oficial da Cloudflare que passa sempre é 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET=
# Cartão 02/18 — chave HMAC-SHA256 do identificador de conta (email normalizado) na caixa negra e nas chaves
# Redis do login; ≥ 32 bytes; gerar com: openssl rand -hex 32. Obrigatória em staging/production; em
# development/test, vazia → chave fixa de desenvolvimento (com aviso no log). Mudá-la reinicia os contadores.
ACCOUNT_HASH_KEY=
# Cartão 02/20 — chave AES-256-GCM dos segredos TOTP do backoffice em repouso: 32 bytes em base64; gerar com:
# openssl rand -base64 32. Obrigatória em staging/production; em development/test, vazia → chave fixa de
# desenvolvimento (com aviso no log). Valores gravados: v1:<kid>:<base64>, kid = 8 hex do sha256 da chave.
# Rotação: a nova vai para TOTP_ENC_KEY e a anterior para TOTP_ENC_KEYS_OLD (sem ela, os TOTP e os códigos de
# recuperação antigos ficam ilegíveis; kid desconhecido = erro). Guardar fora da BD, com backup.
TOTP_ENC_KEY=
# Opcional: chaves antigas (base64 de 32 bytes, separadas por vírgula), SÓ para decifrar/verificar o que foi
# gravado antes da rotação. Nunca cifram.
TOTP_ENC_KEYS_OLD=
# CLI ptmarket-admin (só no terminal do operador, nunca no ambiente da API): ligação do papel DONO das tabelas.
# ADMIN_DATABASE_URL=postgres://ptmarket_migrator:CHANGE_ME@127.0.0.1:5432/ptmarket
