# A API liga como ptmarket_app (sem SUPERUSER/BYPASSRLS). Valores de exemplo, sem segredos reais.
DATABASE_PRIMARY_URL=postgres://ptmarket_app:CHANGE_ME@127.0.0.1:5432/ptmarket
# Fase 1: o mesmo Postgres
DATABASE_REPLICA_URL=postgres://ptmarket_app:CHANGE_ME@127.0.0.1:5432/ptmarket
REDIS_URL=redis://127.0.0.1:6379
BIND_ADDR=127.0.0.1:8080
# Cartão 02/11 (opcionais). Sem PLATFORM_ADMIN_HOST nenhum host é de plataforma.
PLATFORM_ADMIN_HOST=admin.ptmarket.localhost
# Só com este token (>= 32 bytes, gerar com: openssl rand -hex 32) o SSR do Next pode mandar X-Forwarded-Host.
INTERNAL_PROXY_TOKEN=
# Cartão 02/16 (obrigatória): chave HMAC dos tokens CSRF; ≥ 32 bytes; gerar com openssl rand -hex 32
CSRF_KEY=
