{
  "openapi": "3.1.0",
  "info": {
    "title": "PT Market API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Inicia sessão de cliente no tenant do `Host`. Falha → 401 sempre igual (exista ou não a conta).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Sessão iniciada; cookie `__Host-ptm_session` (a sessão anterior deste browser é revogada)"
          },
          "401": {
            "description": "Credenciais inválidas (corpo sempre igual). Com `\"captcha_required\": true` no corpo: repetir com `turnstile_token`"
          },
          "403": {
            "description": "Origin ausente ou de outro site (com sessão: também o token CSRF)"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "422": {
            "description": "Dados inválidos"
          },
          "429": {
            "description": "Demasiadas tentativas; repetir depois de `Retry-After` segundos"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Termina a sessão do pedido: revoga-a, limpa o cookie e grava `auth.logout`. Sem sessão: 204 na\nmesma (idempotente).",
        "operationId": "logout",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Token CSRF da sessão (obrigatório com sessão)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sessão terminada; cookie limpo"
          },
          "403": {
            "description": "Token CSRF ou Origin inválidos"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Regista um cliente (conta global). Responde sempre 202 com o mesmo corpo, exista ou não o\nemail; não inicia sessão.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Pedido aceite (sempre igual, exista ou não a conta)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAccepted"
                }
              }
            }
          },
          "403": {
            "description": "Pedido com sessão iniciada, ou Origin ausente ou de outro site"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "422": {
            "description": "Dados inválidos, password vazada ou verificação anti-robô falhada"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Estado da sessão e token CSRF.",
        "operationId": "session_status",
        "responses": {
          "200": {
            "description": "Estado da sessão (anónimo incluído)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            }
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "Perfil do cliente autenticado (só o próprio: não há id no pedido).",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Perfil do cliente da sessão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfile"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão de cliente"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      },
      "patch": {
        "tags": [
          "customers"
        ],
        "summary": "Altera nome, telefone, NIF e consentimento de marketing do cliente autenticado.",
        "operationId": "patch_me",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Token CSRF da sessão",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Perfil depois da alteração",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfile"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão de cliente"
          },
          "403": {
            "description": "Token CSRF ou Origin inválidos"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "422": {
            "description": "Dados inválidos (ex.: NIF com dígito de controlo errado)"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/staff/auth/login": {
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Inicia sessão de backoffice no host do pedido. Falha → 401 sempre igual (exista ou não a conta,\ntenha ou não papel aqui).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sessão iniciada (cookie `__Host-ptm_session` no tenant, `__Host-ptm_admin` na plataforma); `mfa_required` diz se falta o 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas ou sem acesso a este site (corpo sempre igual). Com `\"captcha_required\": true` no corpo: repetir com `turnstile_token`"
          },
          "403": {
            "description": "Origin ausente ou de outro site (com sessão: também o token CSRF)"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "422": {
            "description": "Dados inválidos"
          },
          "429": {
            "description": "Demasiadas tentativas; repetir depois de `Retry-After` segundos"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/staff/me": {
      "get": {
        "tags": [
          "staff"
        ],
        "summary": "Dados do utilizador de backoffice autenticado (leitura síncrona na caixa negra).",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Utilizador, papéis neste host e estado do 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMe"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão de backoffice"
          },
          "403": {
            "description": "Sem papel neste host"
          },
          "404": {
            "description": "Host desconhecido ou tenant inativo"
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/api/v1/tenant": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "Dados públicos do tenant do domínio pedido.",
        "operationId": "tenant_info",
        "responses": {
          "200": {
            "description": "Tenant do Host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfo"
                }
              }
            }
          },
          "404": {
            "description": "Host desconhecido, inválido ou tenant inativo"
          },
          "429": {
            "description": "Demasiados hosts desconhecidos deste cliente no último minuto",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Segundos até poder repetir"
              }
            }
          },
          "503": {
            "description": "Serviço temporariamente indisponível"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsentsInput": {
        "type": "object",
        "description": "Consentimentos do registo. `marketing` ausente = `false` (nunca pré-assinalado).",
        "required": [
          "terms_version",
          "privacy_version"
        ],
        "properties": {
          "marketing": {
            "type": "boolean"
          },
          "privacy_version": {
            "type": "string",
            "description": "Versão da política de privacidade aceite (obrigatória; 1–64 caracteres)."
          },
          "terms_version": {
            "type": "string",
            "description": "Versão dos termos aceites (obrigatória; 1–64 caracteres)."
          }
        },
        "additionalProperties": false
      },
      "CountryCode": {
        "type": "string",
        "description": "`tenants.country_code`.",
        "enum": [
          "PT",
          "ES"
        ]
      },
      "CustomerProfile": {
        "type": "object",
        "description": "Perfil do cliente autenticado.",
        "required": [
          "id",
          "email",
          "name",
          "phone",
          "nif",
          "consents",
          "created_at"
        ],
        "properties": {
          "consents": {
            "type": "object",
            "description": "`{\"terms\": {\"version\", \"at\"}, \"privacy\": {\"version\", \"at\"}, \"marketing\": {\"granted\", \"at\"}}`\n(`at` em RFC 3339 UTC)."
          },
          "created_at": {
            "type": "string",
            "description": "RFC 3339 UTC."
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "nif": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Pedido de login. Sem `Debug`: leva a password.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Até 255 caracteres; comparado normalizado (trim, NFC, minúsculas)."
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "1 a 128 caracteres; nunca normalizada nem aparada."
          },
          "turnstile_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Token do widget Cloudflare Turnstile; obrigatório quando uma resposta anterior trouxe\n`captcha_required: true` (até 2048 caracteres)."
          }
        },
        "additionalProperties": false
      },
      "ProfilePatch": {
        "type": "object",
        "description": "Alteração do perfil: só os campos presentes mudam. `phone`/`nif` = `\"\"` apagam o valor.\nEmail e password ficam fora (exigem reautenticação).",
        "properties": {
          "marketing": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Consentimento de marketing (datado no servidor)."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "1 a 255 caracteres."
          },
          "nif": {
            "type": [
              "string",
              "null"
            ],
            "description": "PT: 9 dígitos com dígito de controlo; ES: 9 caracteres alfanuméricos; `\"\"` apaga."
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Até 50 caracteres; `\"\"` apaga."
          }
        },
        "additionalProperties": false
      },
      "RegisterAccepted": {
        "type": "object",
        "description": "Resposta do registo: sempre a mesma, exista ou não a conta.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Sempre `ok`."
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "description": "Pedido de registo. Sem `Debug`: leva a password.",
        "required": [
          "email",
          "password",
          "name",
          "consents",
          "turnstile_token",
          "form_started_at"
        ],
        "properties": {
          "consents": {
            "$ref": "#/components/schemas/ConsentsInput"
          },
          "email": {
            "type": "string",
            "description": "Até 255 caracteres; gravado normalizado (trim, NFC, minúsculas)."
          },
          "form_started_at": {
            "type": "integer",
            "format": "int64",
            "description": "Instante em que o formulário foi aberto (ms desde 1970-01-01 UTC)."
          },
          "name": {
            "type": "string",
            "description": "1 a 255 caracteres."
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "8 a 128 caracteres."
          },
          "turnstile_token": {
            "type": "string",
            "description": "Token do widget Cloudflare Turnstile (verificado no servidor; uso único)."
          },
          "website": {
            "type": "string",
            "description": "Honeypot: campo invisível; tem de vir vazio (ou ausente)."
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "type": "string",
        "description": "Papel de backoffice (`user_roles.role`).",
        "enum": [
          "super_admin",
          "tenant_admin",
          "merchant_owner",
          "merchant_staff"
        ]
      },
      "RoleGrant": {
        "type": "object",
        "description": "Um papel com o seu âmbito (`tenant_id`/`store_id` NULL conforme o CHECK da 0018).",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "store_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "tenant_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "SessionStatus": {
        "type": "object",
        "description": "Estado da sessão do pedido.",
        "required": [
          "authenticated",
          "actor_type",
          "csrf_token"
        ],
        "properties": {
          "actor_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "`customer`, `merchant`, `municipal` ou `admin`; `null` se anónimo."
          },
          "authenticated": {
            "type": "boolean"
          },
          "csrf_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Token a enviar em `X-CSRF-Token` (ou no campo `_csrf`) em todas as mutações; `null` se\nanónimo."
          }
        }
      },
      "StaffLoginResponse": {
        "type": "object",
        "description": "Resposta do login de staff.",
        "required": [
          "mfa_required"
        ],
        "properties": {
          "mfa_required": {
            "type": "boolean",
            "description": "`true`: completar o 2FA antes de qualquer ação (super_admin, tenant_admin ou TOTP ligado)."
          }
        }
      },
      "StaffMe": {
        "type": "object",
        "description": "Utilizador de backoffice da sessão: nunca hashes nem segredos.",
        "required": [
          "id",
          "full_name",
          "roles",
          "mfa_verified"
        ],
        "properties": {
          "full_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mfa_verified": {
            "type": "boolean",
            "description": "A sessão já passou o 2FA."
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrant"
            },
            "description": "Só os papéis no âmbito deste host."
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "TemplateLayout": {
        "type": "string",
        "description": "`tenants.template_layout`.",
        "enum": [
          "bairro",
          "editorial",
          "catalogo"
        ]
      },
      "TenantInfo": {
        "type": "object",
        "description": "Dados públicos do tenant do `Host` (nunca ids internos nem comissões).",
        "required": [
          "slug",
          "name",
          "tenant_type",
          "country_code",
          "currency",
          "template_layout",
          "theme_config",
          "legal_config"
        ],
        "properties": {
          "country_code": {
            "$ref": "#/components/schemas/CountryCode"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 (ex.: `EUR`)."
          },
          "legal_config": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "template_layout": {
            "$ref": "#/components/schemas/TemplateLayout"
          },
          "tenant_type": {
            "$ref": "#/components/schemas/TenantType"
          },
          "theme_config": {
            "type": "object"
          }
        }
      },
      "TenantType": {
        "type": "string",
        "description": "`tenants.tenant_type`.",
        "enum": [
          "municipal",
          "national_portal",
          "niche"
        ]
      }
    }
  }
}
